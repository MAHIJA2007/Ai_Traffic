# Local Docker Compose uses the bundled MLflow tracking service.
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# For a DagsHub-backed Compose deployment, set MLFLOW_TRACKING_URI to
# https://dagshub.com/<owner>/<repository>.mlflow and fill username/password
# with your DagsHub username and user token. Keep real credentials in .env only.
